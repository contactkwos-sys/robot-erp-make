# Supabase (REQUIRED on Netlify / production — serverless cannot write local JSON files)
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser (no NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# After setting keys, apply:
#   supabase/migrations/20260811165000_create_app_stores.sql
# Then verify: GET /api/health

# AI Providers (server-side only — never expose to the browser)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Preferred AI provider: mock | claude | openai | gemini
AI_PROVIDER=mock

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# Upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf
